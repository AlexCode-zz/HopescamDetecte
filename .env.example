# Copia este archivo a .env y ajusta los valores.
# Nunca commitees .env (contiene secretos).
# Si no defines SEARCH_PASSWORD, la búsqueda queda deshabilitada.
# Genera un secreto real, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# SEARCH_PASSWORD=tu_contraseña_segura_aqui

# Opcional: chatbot con Claude (sin clave, el chat funciona con RAG local y citas).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=nombre-del-modelo-vigente
